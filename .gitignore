.kotlin/

# build
build
bin

# intellij
.idea

# gradle
.gradle

# Claude Code
.claude/

# Git worktrees
.worktrees/

# Superpowers subagent-driven-development scratch (progress ledger, briefs, reports)
.superpowers/

